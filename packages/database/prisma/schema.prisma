// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL lives in prisma.config.ts (Prisma 7+).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  /// argon2 hash. Omitted from query results by default (see src/client.ts).
  password  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  projects      Project[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  /// SHA-256 hash of the reset token; the raw token is only ever sent to the user.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  /// SHA-256 hash of the refresh JWT; the raw token is never stored.
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String?
  techStack   String[]
  liveUrl     String?
  githubUrl   String?
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
}
