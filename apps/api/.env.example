# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=3001

# Origin allowed by CORS (the Next.js app)
FRONTEND_URL=http://localhost:3000

# DATABASE (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fullstack_challenge?schema=public

# SECURITY: JWT SECRETS (min 32 chars, must differ)
# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# EXPIRATION (format: <number><s|m|h|d>)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Proxies trusted for X-Forwarded-For (false | true | hop count | address list).
# The Next.js BFF forwards the X-Forwarded-For header it received. Only trust it when
# the web tier sits behind a load balancer that appends the real client IP; otherwise
# clients can spoof their IP and dodge rate limits. With false, all traffic through
# the BFF shares one rate-limit bucket (fine locally, not in production).
# Production example (web tier and load balancer subnet): 10.0.0.0/8
TRUST_PROXY=false

# Global rate limit per client (auth routes use stricter limits)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Swagger UI at /api/docs (defaults to enabled outside production)
# SWAGGER_ENABLED=false
