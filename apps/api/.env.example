# Copy to .env and fill in. Never commit real values.

NODE_ENV=development
PORT=3001

# Origin allowed by CORS (the Next.js app)
FRONTEND_URL=http://localhost:3000

# DATABASE (matches docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/fullstack_challenge?schema=public

# SECURITY: JWT SECRETS (min 32 chars, must differ)
# Generate each with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# EXPIRATION (format: <number><s|m|h|d>)
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Proxies trusted for X-Forwarded-For (false | true | hop count | address list).
# The Next.js BFF forwards the client IP; trust it so rate limits apply per user.
# In production set this to your load balancer / web tier, e.g. 10.0.0.0/8.
TRUST_PROXY=loopback

# Global rate limit per client (auth routes use stricter limits)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Swagger UI at /api/docs (defaults to enabled outside production)
# SWAGGER_ENABLED=false
